{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jintia.local/schemas/visual-spec.schema.json",
  "title": "Jintia visual specification",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "pedagogicalIntent", "representation", "altText"],
  "properties": {
    "id": { "type": "string", "pattern": "^fig-[a-z0-9][a-z0-9-]*$" },
    "title": { "type": "string", "minLength": 1 },
    "pedagogicalIntent": {
      "enum": ["identify", "classify", "compare", "sequence", "relate", "hierarchize", "quantify", "locate", "explain-causality", "simulate", "argue"]
    },
    "representation": {
      "enum": ["chart", "forest-plot", "map", "table", "concept-map", "network", "flowchart", "timeline", "signal-diagram", "causal-diagram", "technical-diagram", "interface", "annotated-image", "equation", "disciplinary-notation", "chemical-structure", "chemical-reaction", "syntax-tree", "electrical-circuit", "free-body-diagram", "phylogenetic-tree", "pedigree", "uml", "bpmn", "c4", "sankey", "argument-map", "curriculum-map"]
    },
    "discipline": { "type": "string" },
    "engine": {
      "enum": ["auto", "editorial-svg", "tikz", "graphviz", "mermaid", "plantuml", "d2", "vega-lite", "html", "matplotlib", "geopandas", "rdkit", "circuitikz", "chemfig", "forest", "wavedrom"]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content"],
      "properties": {
        "content": { "type": "string", "minLength": 1 },
        "data": { "type": ["string", "object", "array"] }
      }
    },
    "sourceFile": { "type": "string", "minLength": 1 },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "direction": { "enum": ["TB", "LR", "BT", "RL"] },
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$" },
              "label": { "type": "string", "minLength": 1 },
              "group": { "type": "string" },
              "parent": { "type": "string" },
              "kind": { "type": "string" }
            }
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "to"],
            "properties": {
              "from": { "type": "string" },
              "to": { "type": "string" },
              "label": { "type": "string" }
            }
          }
        },
        "categories": { "type": "array", "items": { "type": "string" } },
        "values": { "type": "array", "items": { "type": "number" } },
        "chartType": { "enum": ["bar", "line", "point", "scatter", "area", "histogram", "boxplot", "heatmap", "interval"] },
        "data": { "type": "array", "items": { "type": "object" } },
        "xField": { "type": "string" },
        "yField": { "type": "string" },
        "groupField": { "type": "string" },
        "facetField": { "type": "string" },
        "upperField": { "type": "string" },
        "units": { "type": "string" },
        "zeroBaseline": { "type": "boolean" },
        "smiles": { "type": "string", "minLength": 1 },
        "formula": { "type": "string", "minLength": 1 },
        "reaction": { "type": "string", "minLength": 1 },
        "diagramType": { "enum": ["class", "sequence", "activity", "state", "component", "use-case"] },
        "components": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "type", "from", "to"],
            "properties": {
              "id": { "type": "string" },
              "type": { "enum": ["resistor", "capacitor", "inductor", "diode", "battery", "voltage-source", "current-source", "switch", "wire"] },
              "from": { "type": "array", "items": { "type": "number" } },
              "to": { "type": "array", "items": { "type": "number" } },
              "label": { "type": "string" },
              "value": { "type": "string" }
            }
          }
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["date", "label"],
            "properties": {
              "date": { "type": "string", "minLength": 1 },
              "label": { "type": "string", "minLength": 1 }
            }
          }
        },
        "signals": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "wave"],
            "properties": {
              "name": { "type": "string" },
              "wave": { "type": "string" },
              "data": { "type": "string" }
            }
          }
        },
        "estimates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "estimate", "lower", "upper"],
            "properties": {
              "label": { "type": "string" },
              "estimate": { "type": "number" },
              "lower": { "type": "number" },
              "upper": { "type": "number" }
            }
          }
        },
        "geojson": { "type": "object" },
        "valueField": { "type": "string" },
        "stages": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "nodeIds"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
              "label": { "type": "string" },
              "nodeIds": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "xTitle": { "type": "string" },
        "yTitle": { "type": "string" }
      }
    },
    "outputFormat": { "enum": ["pdf", "svg", "png"] },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selector", "width", "height"],
      "properties": {
        "selector": { "type": "string", "minLength": 1 },
        "width": { "type": "integer", "minimum": 64, "maximum": 4096 },
        "height": { "type": "integer", "minimum": 64, "maximum": 4096 }
      }
    },
    "placement": { "enum": ["auto", "main", "wide", "margin"] },
    "caption": { "type": "string" },
    "altText": { "type": "string", "minLength": 12 },
    "longDescription": { "type": "string" },
    "readingOrder": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "colorEncoding": { "type": "string" },
    "abbreviations": { "type": "object", "additionalProperties": { "type": "string" } },
    "dataNature": { "enum": ["observed", "estimated", "hypothetical", "mixed"] },
    "dataTable": { "type": "string" },
    "sourceAttribution": { "type": "string" },
    "license": { "type": "string" },
    "provenance": {
      "enum": [
        "original",
        "adapted_from_source",
        "reproduced_from_source",
        "generated_from_verified_data",
        "hypothetical_illustration",
        "interface_mockup",
        "generated_from_verified_content",
        "licensed_image",
        "annotation_on_external_source"
      ]
    },
    "complexity": { "enum": ["low", "medium", "high"] },
    "formalNotationRequired": { "type": "boolean" }
    ,
    "palette": {
      "type": "object",
      "additionalProperties": false,
      "required": ["foreground", "background"],
      "properties": {
        "foreground": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "background": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "series": {
          "type": "array",
          "items": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
        }
      }
    }
  },
  "oneOf": [
    { "required": ["source"] },
    { "required": ["sourceFile"] },
    { "required": ["model"] }
  ]
}
