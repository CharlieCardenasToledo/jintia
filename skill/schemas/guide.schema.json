{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://jintia.dev/schemas/guide.schema.json",
  "title": "Jintia Guide",
  "description": "Fuente canónica neutra (AST) de una guía semanal Jintia. El renderer convierte este documento en HTML semántico y después en PDF.",
  "type": "object",
  "required": ["metadata", "sections"],
  "additionalProperties": false,
  "properties": {
    "metadata": {
      "type": "object",
      "description": "Metadatos editoriales y pedagógicos del documento.",
      "required": ["course", "week", "topic", "outcome"],
      "additionalProperties": false,
      "properties": {
        "course": {
          "type": "string",
          "description": "Nombre de la asignatura."
        },
        "code": {
          "type": "string",
          "description": "Código institucional de la asignatura."
        },
        "week": {
          "type": "integer",
          "minimum": 1,
          "description": "Número de semana."
        },
        "topic": {
          "type": "string",
          "description": "Tema o título principal de la guía."
        },
        "outcome": {
          "type": "string",
          "description": "Resultado de aprendizaje canónico de la semana."
        },
        "unit": {
          "type": "string",
          "description": "Unidad a la que pertenece la semana."
        },
        "period": {
          "type": "string",
          "description": "Periodo académico ordinario (ej. '2024-II')."
        },
        "hours": {
          "type": "number",
          "description": "Horas estimadas de trabajo autónomo."
        },
        "theme": {
          "type": "string",
          "default": "jintia-clasico",
          "description": "ID del tema HTML a usar para el renderizado.",
          "enum": ["jintia-clasico", "jintia-tecnico", "jintia-cuaderno"]
        },
        "engine": {
          "type": "string",
          "default": "vivliostyle",
          "description": "Motor PDF a usar para la compilación.",
          "enum": ["vivliostyle"]
        },
        "lang": {
          "type": "string",
          "default": "es",
          "description": "Idioma del documento (código BCP 47)."
        },
        "citationStyle": {
          "type": "string",
          "default": "apa",
          "description": "Estilo bibliográfico CSL (ej. 'apa', 'chicago-author-date')."
        },
        "bibliography": {
          "type": "string",
          "description": "Ruta relativa al archivo .bib de la guía (ej. 'reference.bib')."
        },
        "authors": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Nombres de los docentes autores."
        },
        "targets": {
          "type": "array",
          "description": "Desempeños observables en los que se descompone metadata.outcome (ej. T1, T2...). Opcional: habilita la matriz de alineación JIN-ALN-01x.",
          "items": {
            "type": "object",
            "required": ["id", "description"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^T[0-9]+$",
                "description": "Identificador del target (ej. 'T1')."
              },
              "verb": {
                "type": "string",
                "description": "Verbo observable del desempeño (ej. 'diagnosticar', 'diferenciar')."
              },
              "description": {
                "type": "string",
                "description": "Desempeño observable que demuestra este target."
              }
            }
          }
        }
      }
    },
    "sections": {
      "type": "array",
      "description": "Secuencia ordenada de nodos pedagógicos del documento.",
      "minItems": 1,
      "items": { "$ref": "#/definitions/section" }
    }
  },
  "definitions": {
    "section": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "description": "Tipo de nodo pedagógico. NOTA: 'citation' está DEPRECADO — usar sintaxis inline {{cite:clave}} en campos content.",
          "enum": [
            "orientation",
            "theory",
            "concept",
            "warning",
            "critical-error",
            "practice",
            "figure",
            "table",
            "scenario",
            "assessment",
            "margin-note",
            "bibliography",
            "citation"
          ]
        },
        "id": {
          "type": "string",
          "description": "Identificador único del nodo (para referencias cruzadas).",
          "pattern": "^[a-z0-9-]+$"
        },
        "title": {
          "type": "string",
          "description": "Título o encabezado del bloque."
        },
        "content": {
          "description": "Contenido del nodo. Puede ser string HTML seguro, array de sub-nodos u objeto estructurado según el tipo."
        },
        "pagination": {
          "type": "string",
          "description": "Comportamiento de paginación del bloque.",
          "enum": [
            "atomic",
            "splittable",
            "repeatable-header",
            "keep-with-next",
            "page-contained"
          ]
        },
        "targetIds": {
          "type": "array",
          "items": { "type": "string", "pattern": "^T[0-9]+$" },
          "description": "Targets de metadata.targets que este nodo enseña, practica o evalúa. Habilita JIN-ALN-01x."
        },
        "claimIds": {
          "type": "array",
          "items": { "type": "string" },
          "description": "IDs de afirmación en evidence.json que este nodo redacta. Ver evidence.schema.json."
        },
        "estimatedMinutes": {
          "type": "number",
          "minimum": 0,
          "description": "Minutos de trabajo autónomo que consume este nodo. Habilita JIN-WRK-*."
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "orientation" } } },
          "then": {
            "properties": {
              "purpose": {
                "type": "string",
                "description": "Propósito de la semana, explicado sin listar el resultado de aprendizaje textualmente."
              },
              "priorKnowledge": {
                "type": "array",
                "items": { "type": "string" },
                "description": "Conocimientos previos que el estudiante necesita antes de empezar."
              },
              "materials": {
                "type": "array",
                "items": { "type": "string" },
                "description": "Materiales o recursos necesarios para completar la semana."
              },
              "route": {
                "type": "array",
                "items": { "type": "string" },
                "description": "Ruta de esta semana: secuencia de pasos o secciones que el estudiante recorrerá."
              },
              "successCriteria": {
                "type": "array",
                "items": { "type": "string" },
                "description": "Criterios de éxito de la semana completa."
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "practice" } } },
          "then": {
            "properties": {
              "mode": {
                "type": "string",
                "default": "guided",
                "enum": ["guided", "retrieval", "independent", "transfer"],
                "description": "guided = práctica guiada; retrieval = recuperación; independent = práctica autónoma; transfer = transferencia."
              },
              "workedExample": {
                "description": "Modelo o ejemplo trabajado. Obligatorio cuando mode='guided' (JIN-SELF-002)."
              },
              "prompt": {
                "type": "string",
                "description": "Consigna de la práctica."
              },
              "steps": {
                "type": "array",
                "items": { "type": "string" },
                "description": "Pasos guiados de la práctica."
              },
              "hints": {
                "type": "array",
                "items": { "type": "string" },
                "description": "Pistas disponibles ante bloqueo del estudiante."
              },
              "successCriteria": {
                "type": "array",
                "items": { "type": "string" },
                "description": "Criterios de éxito observables. Obligatorio (JIN-SELF-003)."
              },
              "selfCheck": {
                "description": "Mecanismo de autocorrección (respuesta modelo, checklist o comparación). Ver JIN-SELF-004."
              },
              "feedback": {
                "description": "Retroalimentación asociada a la práctica. Ver JIN-SELF-004."
              },
              "remediation": {
                "description": "Ruta de recuperación cuando el desempeño no alcanza el criterio de éxito. Ver JIN-SELF-005."
              },
              "transfer": {
                "description": "Consigna de transferencia a un contexto distinto. Ver JIN-SELF-009."
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "figure" } } },
          "then": {
            "required": ["alt", "caption"],
            "properties": {
              "src": {
                "type": "string",
                "minLength": 1,
                "description": "Ruta relativa a la imagen ya renderizada (ej. 'figure/rendered/fig-id.svg')."
              },
              "alt": {
                "type": "string",
                "minLength": 1,
                "description": "Texto alternativo accesible. Obligatorio."
              },
              "caption": {
                "type": "string",
                "minLength": 1,
                "description": "Caption de la figura. Obligatorio."
              },
              "width": {
                "type": "string",
                "description": "Ancho CSS (ej. '100%', '80mm')."
              },
              "visualSpec": {
                "type": "string",
                "minLength": 1,
                "description": "Ruta a un visual-spec.json para generación dinámica (alternativa a src)."
              }
            },
            "anyOf": [
              { "required": ["src"] },
              { "required": ["visualSpec"] }
            ]
          }
        },
        {
          "if": { "properties": { "type": { "const": "table" } } },
          "then": {
            "required": ["caption"],
            "properties": {
              "caption": {
                "type": "string",
                "minLength": 1,
                "description": "Caption de la tabla. Obligatorio."
              },
              "headers": {
                "type": "array",
                "items": { "type": "string" },
                "description": "Encabezados de columna."
              },
              "rows": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "description": "Filas de datos."
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "citation" } } },
          "then": {
            "required": ["keys"],
            "properties": {
              "keys": {
                "type": "array",
                "items": { "type": "string" },
                "minItems": 1,
                "description": "Claves bibliográficas (deben existir en reference.bib)."
              },
              "mode": {
                "type": "string",
                "default": "parenthetical",
                "enum": ["narrative", "parenthetical"],
                "description": "Modo de cita: narrative = 'Autor (año)'; parenthetical = '(Autor, año)'."
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "assessment" } } },
          "then": {
            "properties": {
              "format": {
                "type": "string",
                "enum": ["multiple-choice", "open", "matching", "ordering", "case"],
                "description": "Formato de la actividad evaluativa."
              },
              "items": {
                "type": "array",
                "description": "Ítems o preguntas de la actividad."
              },
              "code": {
                "type": "string",
                "description": "Código de la actividad calificada según el sílabo (ej. 'PE-1.1')."
              },
              "instructions": {
                "type": "string",
                "description": "Instrucciones de la actividad para el estudiante."
              },
              "product": {
                "type": "string",
                "description": "Producto observable esperado. Obligatorio (JIN-ASM-011)."
              },
              "criteria": {
                "type": "array",
                "description": "Criterios de evaluación. Obligatorio (JIN-ASM-010).",
                "items": {
                  "type": "object",
                  "required": ["description"],
                  "properties": {
                    "description": { "type": "string" },
                    "weight": { "type": "number", "minimum": 0, "maximum": 100 }
                  }
                }
              },
              "points": {
                "type": "number",
                "minimum": 0,
                "description": "Puntaje/ponderación de la actividad según el sílabo, si es calificada."
              },
              "submissionChecklist": {
                "type": "array",
                "items": { "type": "string" },
                "description": "Checklist de entrega para el estudiante."
              }
            }
          }
        }
      ]
    }
  }
}
